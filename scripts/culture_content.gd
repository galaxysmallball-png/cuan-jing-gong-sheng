const CULTURE: Array[Dictionary] = [
	{"title":"一字入门，识得二爨", "subtitle":"爨读 cuàn · 从曲靖的碑刻出发", "body":"[b]两块碑，两段可触摸的历史[/b]\n《爨宝子碑》立于公元405年，俗称“小爨”；《爨龙颜碑》立于公元458年，俗称“大爨”。二者合称“二爨”，是认识云南古代历史与书法的重要实物。\n\n[b]看字，也看字背后的人[/b]\n小爨的书写保留隶意，又呈现楷书的发展面貌。碑文还留下人物、职官与地方社会的信息。读碑，既是赏字，也是走近曾在南中生活的人。", "sources":[0, 1, 3]},
	{"title":"笔墨与山川，留住往来", "subtitle":"文化交流，不只存在于远行的路上", "body":"[b]共同使用的文字，地方生活的记忆[/b]\n碑刻以汉字记录南中人物和地方事务，文字、文辞与书写风格为理解区域间的文化联系留下了线索。它们既有共同的文字传统，也有鲜明的地方风貌。\n\n[b]理解交融，需要看见具体的人[/b]\n爨文化不是某一个现代民族的单一标签。我们可从碑刻、地方史和人的往来，理解文化如何被学习、使用与传承；古代族群名称，也不宜直接等同于今天的民族分类。", "sources":[0, 2, 3]},
	{"title":"共同守护，便有共同记忆", "subtitle":"爨文化在交往交流交融中的意义", "body":"[b]让遗产成为相遇的地方[/b]\n国家民委刊载的云南工作资料，把爨文化碑列入研究各民族交往交流交融的历史实物。碑刻研究、博物馆展示和书法学习，让不同来处的人有机会共同认识一段历史。\n\n[b]让相助落在日常之中[/b]\n本作用认字、修桥、递绳、煮茶和点灯，表现彼此需要、共同创造的过程。这是游戏的主题表达：保留各自的生活色彩，也能共同守护一份文化记忆。", "sources":[0, 2]},
	{"title":"有据可寻，有情可寄", "subtitle":"资料与创作的边界", "body":"[b]可以查证的内容[/b]\n二爨的年代、文物与书法价值，可查阅下列公开资料。游戏内文字为整理转述，可离线阅读；点击来源，可联网查看原文。\n\n[b]属于这段故事的内容[/b]\n邓书年等八位人物、四人护碑过溪与七灯共庭，是原创叙事。人物衣饰、手艺与乡音依剧本及角色卡设计，不概括某个民族每个人的生活。长卷画面为艺术创作。", "sources":[0, 1, 2, 3]}
]
const PEOPLE: Array[Dictionary] = [
	{"name":"邓书年（汉族）", "role":"寻文者 · 私塾先生 · 三十二岁", "home":"祖上自江西随明初屯军落籍曲靖。他生长于南中，在乡里教私塾，带着家中传下的读书与笔墨习惯来到碑前。", "daily":"青布长衫的袖口磨白，儒巾与拓包随身。认字、教书、临帖是他的日常；说话文白相间，着急时也会冒出曲靖土话。", "wish":"原想证明自己读得懂天下字，却认不全碑上的古字。此行使他学会向匠人和同行求教：识字的本领，也须与别人的经验相接。"},
	{"name":"石阿朵（白族）", "role":"百工匠 · 石匠后人 · 二十四岁", "home":"来自曲靖坝子白、汉杂居的村落，家里三代打碑、修坝、砌灶。她的手艺从家中和乡邻的劳作里学来。", "daily":"蓝包头缀着白穗，卷袖配青布围裙；錾子、木锤和铜哨随身。她说坝子话，做事先察石质、墩脚与受力，话短而直。", "wish":"碑是乡邻从田里发现的，她起初只想把它留在村中。后来发现，护住它需要读字、认路、打榫与递绳的众手。"},
	{"name":"老箐（彝族）", "role":"行路人 · 乌蒙山赶马人 · 五十余岁", "home":"出自乌蒙山东麓的彝族村寨，年轻时跑过曲靖、昭通到宜宾的马帮路。山路、水痕和马铃声，都是他积攒的经验。", "daily":"披毡、麻绳、布袋与铜马铃相伴，杖不离手。说汉话带乡音，惯用短句；过溪先看桥脚，走夜路记着同行人是否都跟上。", "wish":"他本来只是路过，看见碑倒着便想扶一把。救碑之后，他在意的也不只是石头，而是这一夜同行的人都能平安抵达。"},
	{"name":"杨三娘（回族）", "role":"联络者 · 来自保山的女货郎 · 四十出头", "home":"她的娘家是保山汉族人家，丈夫是回族商人。往来南北的家庭与行商经历，让她熟悉不同乡音，也学会尊重各家不同的生活规矩。", "daily":"深色包头、蓝衣棕马甲，一副挑子装针线与糖果，小秤和零钱随身。走街多年，汉、白、彝话都能来几句，也知道不同人家有各自的礼俗。", "wish":"她把书生的文话换成乡邻听得懂的话，把赶马人的短句讲给众人听。她要做的，是让互不相识的人先肯坐下来，再一同把碑管起来。"},
	{"name":"阿彩（苗族）", "role":"苗家新妇 · 务农的年轻母亲 · 二十八岁", "home":"来自附近苗族人家，背着熟睡的孩子赶来帮忙。她的话少，常以“好”“抬”“稳住”回应，行动总比长篇话语更快。", "daily":"黑布盘头配红蓝花带，衣领与袖口用蓝底白花，背婴布绣着花纹；小锄头与竹篓随身，既顾孩子，也顾田地与家中活计。", "wish":"杨三娘来请，她便带着绳索到桥边。搭桥时的那一把力，不需要先说出什么大道理，同行的人自会记得。"},
	{"name":"普嫫（彝族）", "role":"掌火塘者 · 乌蒙山老人 · 六十岁", "home":"与老箐来自同一村寨，熟悉山路上留火、暖茶的生活。她不负责搬碑修桥，却在院中为抵达的人留着一份热意。", "daily":"黑布包头、木簪与旧披毡，腰边布袋收着火石和干茶。黑陶罐盛茶，三足铜火盆留炭；衣领、袖口的细彩边保留着来处的颜色。", "wish":"众人把物件安放好，她便邀人来取灯、歇脚。她的叮嘱落在一句平常话里：“火点着了，就不散了。”"},
	{"name":"玉喃（傣族）", "role":"布商 · 保山来的同行者 · 三十五岁", "home":"从云南保山来，沿路售卖织锦与布匹，与杨三娘是路上的伴当。毛驴驮着布卷，山路把生意也把人情带进不同村镇。", "daily":"低髻插木梳，水红短衣、黑筒裙与傣锦裙边，银腰带轻系。她整理布匹、照料驮货的毛驴，也把锦带系在灯柄上，便于诸位提握。", "wish":"她送来的不只是几段布，而是愿意一同照亮院子的心意。灯有了归处，赶路的人也能暂歇。"},
	{"name":"阿强（壮族）", "role":"木工青年 · 靠手艺吃饭 · 二十二岁", "home":"来往山间的木工青年，识得木料与榫卯，靠一双手做活。见桥断了，便扛着杉木同阿彩来帮忙。", "daily":"露额黑头巾、靛蓝对襟短衣、红布腰带，卷裤脚穿草鞋。肩上杉木留着榫口，腰间柴刀入木鞘；木梁与绳结做得牢，心里才踏实。", "wish":"架桥时他打紧榫口，也用一句“木梁已稳，过桥慢些”稳住人心。木工的这道工序，与众人的本领相接，才成一条过溪的路。"}
]
const SCROLL: Array[Dictionary] = [
	{"title":"一桥相扶，众手成路", "text":"认字、辨向、砌墩、打榫、递绳、举火——每个人做的事不同，却让同一块碑过了溪。\n桥由众手搭成，碑由众人护稳。\n共生，便从彼此需要、彼此相助开始。"},
	{"title":"七色各异，共照一灯", "text":"汉族的蓝衫与拓片、白族的白穗与錾子、彝族的披毡与火塘；\n回族的货担、苗族的蜡染、壮族的榫木、傣族的锦带，各自留着来处的颜色。\n八位来客、七个民族，共把这间院子照亮。"},
	{"title":"代代守望，文脉未断", "text":"挖起、扶正、识读、守护，碑前的人换了一代又一代。\n今天站在碑前的少年，承接的是先人共同守护的文化遗产。\n这份记忆，属于共同生活在这片土地上的人。"},
	{"title":"同源异彩，和合共生", "text":"各有语言、衣饰与习俗，也能为同一条路、同一座桥、同一盏灯并肩出力。\n从一方庭院到万家灯火，差异留作光彩，守望连成家园。\n多元一体的中华民族，在共同生活、共同创造中续写共生的故事。"}
]
